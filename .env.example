# Raftaar: copy to .env, fill in the value marked REQUIRED, then run:
#   docker compose up -d            (uses the published image)
#   docker compose up -d --build    (or builds this checkout)
# compose.yaml reads everything from here, so it never needs editing.

# ---- Image -----------------------------------------------------------------------------------------------
# Which image to run. Pin an exact version (recommended): you choose when the database migrates.
APP_IMAGE=ghcr.io/rithask/raftaar
APP_VERSION=latest

# ---- Network ---------------------------------------------------------------------------------------------
# 127.0.0.1 = only reachable from this machine (put a reverse proxy such as Caddy in front for HTTPS).
# 0.0.0.0   = reachable from your network.
APP_BIND=127.0.0.1
APP_PORT=8080
TZ=Asia/Kolkata

# ---- Sign-in ---------------------------------------------------------------------------------------------
# The first time you open Raftaar it asks you to create your account (with a password, or with the OIDC
# provider below). Until then anyone who can reach it could do that, so keep APP_BIND=127.0.0.1 or open it
# right after starting.
#
# Or create the account here instead (only used while there's no account yet). A plain password, or a bcrypt
# hash like {bcrypt}$2a$10$...
# APP_USERNAME=admin
# APP_PASSWORD=
#
# Locked out? Set this, restart, sign in with it, then remove it again: it replaces your password on start.
# RESET_PASSWORD=

# ---- Sign-in with an identity provider (optional) --------------------------------------------------------
# OpenID Connect, e.g. Pocket ID, Authelia, Authentik or Keycloak. At the provider, add an OIDC client with:
#   callback URL   https://<this app's address>/login/oauth2/code/oidc
#   scopes         openid profile email
# The first time you sign in with it, Raftaar asks to link that account to yours (your password confirms it).
# After that only that account can sign in with the provider; unlink it in Settings → Account.
OIDC_ISSUER_URI=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
# The name on the sign-in button
OIDC_PROVIDER_NAME=Pocket ID
# Go straight to the provider from the sign-in page (not right after signing out, so you can still choose)
OIDC_AUTO_REDIRECT=true
# false hides the password form. Only takes effect once OIDC is set up, so you can't lock yourself out.
PASSWORD_LOGIN=true

# ---- Database (REQUIRED) ---------------------------------------------------------------------------------
POSTGRES_PASSWORD=
POSTGRES_USER=raftaar
POSTGRES_DB=raftaar
# The major version can't simply be changed later: see docs/versioning.md, "Upgrading PostgreSQL".
POSTGRES_VERSION=18

# ---- Files on this machine -------------------------------------------------------------------------------
# Data is kept in ./data next to compose.yaml: ./data/files (photos, scans) and ./data/db (the database).
# The app writes ./data/files as this user and group; set them to your own (run `id`) to own those files.
PUID=10001
PGID=10001

# ---- GeoPulse (optional) ---------------------------------------------------------------------------------
# Imports your trips and spots stops at fuel pumps. A token with the "read" scope is enough.
GEOPULSE_URL=
GEOPULSE_TOKEN=
# GEOPULSE_POLL_INTERVAL=PT30M
# GEOPULSE_IMPORT_DAYS=30
# GEOPULSE_MOVEMENT_TYPES=CAR,MOTORCYCLE,UNKNOWN
# Put a trip on a vehicle without asking when only one of your vehicles fits
# GEOPULSE_AUTO_ASSIGN=false

# ---- Hisaab (optional) -----------------------------------------------------------------------------------
# Brings in fuel payments. A "Read transactions" token, money out only; turn on Settings → Features → Data API there.
HISAAB_URL=
HISAAB_TOKEN=
# HISAAB_POLL_INTERVAL=PT15M
# HISAAB_IMPORT_DAYS=30
# Category names or ids: fuel ones become fill-ups to confirm, expense ones become expenses to confirm
# HISAAB_FUEL_CATEGORIES=Fuel
# HISAAB_EXPENSE_CATEGORIES=Vehicle maintenance

# ---- Pump & state lookup (optional) ----------------------------------------------------------------------
# Names the fuel pump and state of a fill-up using OpenStreetMap. Sends the coordinates of your stops there;
# point these at your own instances, or turn it off.
# OSM_LOOKUPS_ENABLED=true
# OVERPASS_URL=https://overpass-api.de/api/interpreter
# NOMINATIM_URL=https://nominatim.openstreetmap.org
# A price source of your own: a URL with {state} {district} {fuel} that answers {"price": 102.5}
# FUEL_PRICE_URL=

# ---- Notifications (optional) ----------------------------------------------------------------------------
# Channels are easiest to add in Settings → Notifications. Fixed ones can go here: Apprise URLs, comma separated.
# APPRISE_URLS=ntfys://ntfy.sh/your-topic
# When the daily check for due services and expiring papers runs (sec min hour day month weekday)
# ALERT_CRON=0 0 9 * * *

# ---- Advanced --------------------------------------------------------------------------------------------
# JAVA_OPTS=-XX:MaxRAMPercentage=75
# LOG_LEVEL=INFO
